# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon PostgreSQL connection string for Vercel Serverless API routes.
# Example: postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# VITE_API_BASE_URL: Optional remote API origin when building Android APK via Capacitor.
# Leave empty when deployed on Vercel (same-origin /api/*).
# Set to your Vercel deployment URL (e.g. https://vantrex-attendance.vercel.app) before running `npx cap sync android`.
VITE_API_BASE_URL=""
